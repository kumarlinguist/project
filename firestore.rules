rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(groupId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
    }
    match /groups/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn() && request.auth.uid in request.resource.data.memberIds;
      allow update: if signedIn() && request.auth.uid in resource.data.memberIds;
      match /messages/{messageId} {
        allow read, create: if member(groupId);
        allow update, delete: if member(groupId);
      }
    }
    match /chats/{chatId} {
      allow read, write: if signedIn() && (chatId.matches(request.auth.uid + '_.*') || chatId.matches('.*_' + request.auth.uid));
      match /messages/{messageId} {
        allow read, create, update, delete: if signedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid || request.resource.data.senderId == request.auth.uid || request.resource.data.receiverId == request.auth.uid);
      }
      match /typing/{uid} { allow read, write: if signedIn(); }
    }
  }
}
